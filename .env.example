# =========================================================
# LevelUP — Variáveis de ambiente (MODELO, sem valores reais)
# =========================================================
# Este ficheiro VAI para o GitHub. Nunca coloques aqui valores reais.
#
# Para desenvolver localmente:
#   1. Copia este ficheiro para ".env.local"
#   2. Preenche os valores com os do teu projeto Supabase
# O ".env.local" é ignorado pelo Git e nunca vai para o GitHub.
# =========================================================

# URL do projeto Supabase
VITE_SUPABASE_URL=

# Chave PÚBLICA do Supabase (publishable / anon).
# Pode estar no frontend: a segurança dos dados vem das regras RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ NUNCA adicionar aqui a chave SECRETA / service_role.
# Essa chave ignora o RLS e dá acesso total à base de dados.