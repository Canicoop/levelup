{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(*skills/impeccable/scripts/impeccable*)",
      "Bash(*skills\\impeccable\\scripts\\impeccable*)",
      "Bash(./impeccable*)",
      "Bash(impeccable *)",
      "Bash(*impeccable.cmd*)",
      "Bash(*impeccable.exe*)",
      "Bash(npx impeccable*)",
      "PowerShell(*skills/impeccable/scripts/impeccable*)",
      "PowerShell(*skills\\impeccable\\scripts\\impeccable*)",
      "PowerShell(./impeccable*)",
      "PowerShell(.\\impeccable*)",
      "PowerShell(impeccable *)",
      "PowerShell(*impeccable.cmd*)",
      "PowerShell(*impeccable.exe*)",
      "PowerShell(npx impeccable*)",
      "mcp__playwright__browser_run_code_unsafe"
    ]
  }
}